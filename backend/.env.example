# Copy to backend/.env and fill in real values. Never commit .env.

ENVIRONMENT=development
APP_ORIGIN=http://localhost:5173

# App connection (least-privilege role created by scripts/create_db.py)
DATABASE_URL=postgresql+asyncpg://aqs_app:CHANGE_ME_APP_PASSWORD@localhost:5432/aqs

# Superuser connection — the same login you use in pgAdmin 4. Only used by scripts/create_db.py.
POSTGRES_ADMIN_URL=postgresql://postgres:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/postgres

# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID → Web application)
# Authorized redirect URI: http://localhost:5173/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=up.edu.ph
